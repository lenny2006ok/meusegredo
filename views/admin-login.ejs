<%- include('partials/header', { title: 'Admin' }) %>
<main class="page-content page-form">
  <div class="form-card">
    <h1>Área de Administração</h1>
    <% if (error) { %>
      <p class="small" style="color: var(--red);"><%= error %></p>
    <% } %>
    <form action="/admin/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>Usuário<input name="username" required /></label>
      <label>Senha<input name="password" type="password" required /></label>
      <button class="button button-red">Entrar</button>
    </form>
  </div>
</main>
<%- include('partials/footer') %>
