<%- include('partials/header', { title: 'Contar um Segredo' }) %>
<main class="page-content page-form">
  <div class="form-card">
    <h1>Contar um Segredo</h1>
    <p class="lead">Compartilhe anonimamente e ajude outras pessoas com sua história.</p>
    <form action="/contar" method="POST" class="secret-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>
        Título do segredo
        <input name="title" maxlength="100" required />
      </label>
      <label>
        Categoria
        <select name="category" required>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.key %>"><%= cat.label %></option>
          <% }) %>
        </select>
      </label>
      <label>
        Segredo
        <textarea name="secret" rows="8" maxlength="5000" required></textarea>
      </label>
      <label>
        Nome fictício <span class="secondary">(opcional)</span>
        <input name="pseudonym" placeholder="Ex: Lua Azul" />
      </label>
      <label>
        Cidade <span class="secondary">(opcional)</span>
        <input name="city" />
      </label>
      <label>
        Idade <span class="secondary">(opcional)</span>
        <input name="age" type="number" min="1" max="120" />
      </label>
      <label class="checkbox-group">
        <input type="checkbox" name="termsAccepted" required />
        Li e aceito os termos de uso
      </label>
      <label>
        Proteção anti-spam: <strong><%= captchaQuestion %></strong>
        <input name="captchaAnswer" required placeholder="Resposta" />
      </label>
      <input type="text" name="honey" style="display:none" autocomplete="off" />
      <div class="form-actions">
        <button type="submit" class="button button-red">Enviar Segredo</button>
      </div>
      <p class="small">Não identifique pessoas reais. Foque em compartilhar sua história ou pedir conselhos.</p>
    </form>
  </div>
</main>
<%- include('partials/footer') %>
