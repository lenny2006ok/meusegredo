<%- include('partials/header', { title: 'Ranking' }) %>
<main class="page-content page-ranking">
  <section class="ranking-grid">
    <article class="ranking-card">
      <h2>Mais Vistos de Hoje</h2>
      <ol>
        <% today.forEach(post => { %>
          <li><a href="/segredo/<%= post.id %>"><%= post.title %></a> - <span><%= post.views %> views</span></li>
        <% }) %>
      </ol>
    </article>
    <article class="ranking-card">
      <h2>Mais Comentados da Semana</h2>
      <ol>
        <% week.forEach(post => { %>
          <li><a href="/segredo/<%= post.id %>"><%= post.title %></a> - <span><%= post.comment_count %> comentários</span></li>
        <% }) %>
      </ol>
    </article>
    <article class="ranking-card">
      <h2>Mais Curtidos do Mês</h2>
      <ol>
        <% month.forEach(post => { %>
          <li><a href="/segredo/<%= post.id %>"><%= post.title %></a> - <span><%= post.likes %> curtidas</span></li>
        <% }) %>
      </ol>
    </article>
  </section>
</main>
<%- include('partials/footer') %>
